# See docs/12-engineering-conventions.md §7 for what each of these is for.
# Copy to .env (root) and apps/api/.env as needed — never commit the real file.

DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
AI_GATEWAY_API_KEY=
VOYAGE_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# TCP/TLS connection string for the same Upstash Redis database (Connect →
# TCP tab, not REST) — required for BullMqIngestionQueue (findings-log.md
# #5/#40). Falls back to the non-durable in-process queue if unset; a
# production boot fails fast instead of doing that silently.
UPSTASH_REDIS_URL=
# Supabase Storage bucket name for knowledge documents (create it in the
# Supabase dashboard first). Falls back to local-filesystem storage if
# unset; a production boot fails fast instead of doing that silently.
SUPABASE_STORAGE_BUCKET=
# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`
# when invoking POST /internal/ingestion/tick (findings-log.md #40).
CRON_SECRET=
POSTHOG_KEY=
SENTRY_DSN=
